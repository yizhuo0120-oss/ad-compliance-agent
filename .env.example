# 复制为 .env 并填入真实 Key；.env 已被 .gitignore 排除，绝不提交

# DeepSeek —— 唯一主力供应商，一个 Key 全包：
#   ① 文本判断：deepseek-flash 法条比对、生成报告（批量评测也用它）
#   ② 视觉通道：deepseek-flash 原生支持图像输入，负责海报转写 + 视觉判定
DEEPSEEK_API_KEY=

# 智谱开放平台（可选备胎）：glm-4v-flash 免费额度
#   仅在 DeepSeek 视觉不可用时顶替，或 D8/卡9 做视觉对比实验时启用
ZHIPU_API_KEY=

# HuggingFace 国内镜像（下载 BGE Embedding 模型用）
HF_ENDPOINT=https://hf-mirror.com
