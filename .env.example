# ========= 当前启用的供应商：deepseek | zhipu | dashscope =========
# 切换供应商/模型只改这里和下面对应区块，代码零改动
LLM_PROVIDER=deepseek

# ---------- DeepSeek（主力：deepseek-flash 文本+视觉一体） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TEXT_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash

# ---------- 智谱（备胎：视觉切 glm-4v-flash） ----------
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_TEXT_MODEL=glm-5.3
ZHIPU_VISION_MODEL=glm-4v-flash

# ---------- 阿里云百炼（备用） ----------
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_TEXT_MODEL=qwen-plus
DASHSCOPE_VISION_MODEL=qwen-vl-max

# ---------- HuggingFace 国内镜像（下载 BGE Embedding 用） ----------
HF_ENDPOINT=https://hf-mirror.com
